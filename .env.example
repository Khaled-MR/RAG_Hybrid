# Copy to ".env" and adjust if needed:  cp .env.example .env
# docker compose reads this automatically.

# LLM served by Ollama (any Qwen tag works). Pulled automatically on first run.
LLM_MODEL=qwen2.5:7b

# Set to 1 for fully offline operation AFTER the BGE models have been cached
# once (no calls to huggingface.co). Leave 0 on the very first run.
HF_HUB_OFFLINE=0
